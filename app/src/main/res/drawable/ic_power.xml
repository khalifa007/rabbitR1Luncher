        android:pathData="M10,0 h4 v10 h-4 z
                          M4,6 h2 v2 h-2 z
                          M18,6 h2 v2 h-2 z
                          M2,8 h4 v2 h-4 z
                          M18,8 h4 v2 h-4 z
                          M0,10 h4 v6 h-4 z
                          M20,10 h4 v6 h-4 z
                          M2,16 h4 v2 h-4 z
                          M18,16 h4 v2 h-4 z
                          M4,18 h4 v2 h-4 z
                          M16,18 h4 v2 h-4 z
                          M6,20 h12 v2 h-12 z" />
</vector>
