<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixel-art messages icon: speech bubble with stepped tail and two text-lines
  cut as black "windows". 12x12 logical grid, each pixel = 2x2 viewport units.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2,0 h18 v16 h-18 z
                          M2,16 h10 v2 h-10 z
                          M6,18 h6 v2 h-6 z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M6,4 h10 v2 h-10 z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M6,10 h8 v2 h-8 z" />
</vector>
