<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixel-art wifi icon: outer chevron with stepped wings, middle arc with
  short wings, inner arc, and a center dot. Reads as )))-style wifi rendered
  in chunky hard pixels. Viewport 14x10 matches the topbar Image size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="14dp"
    android:height="10dp"
    android:viewportWidth="14"
    android:viewportHeight="10">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2,0 h10 v1 h-10 z
                          M1,1 h2 v1 h-2 z
                          M11,1 h2 v1 h-2 z
                          M0,2 h1 v1 h-1 z
                          M13,2 h1 v1 h-1 z
                          M3,3 h8 v1 h-8 z
                          M2,4 h1 v1 h-1 z
                          M11,4 h1 v1 h-1 z
                          M5,6 h4 v1 h-4 z
                          M6,8 h2 v1 h-2 z" />
</vector>
