<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixel-art folder: front lip tab transitioning to filled body.
  12x12 logical grid, each pixel = 2x2 viewport units.
  tint="@color/fg" preserved so callers control the rendered color.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="28dp"
    android:height="28dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/fg">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,2 h8 v2 h-8 z
                          M4,4 h18 v2 h-18 z
                          M2,6 h20 v16 h-20 z" />
</vector>
