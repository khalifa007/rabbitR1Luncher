<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixel-art send arrow: right-pointing play-triangle, symmetric on Y.
  12x12 logical grid, each pixel = 2x2 viewport units. Centered ~x=6..18.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6,2 h2 v2 h-2 z
                          M6,4 h4 v2 h-4 z
                          M6,6 h6 v2 h-6 z
                          M6,8 h8 v2 h-8 z
                          M6,10 h10 v2 h-10 z
                          M6,12 h10 v2 h-10 z
                          M6,14 h8 v2 h-8 z
                          M6,16 h6 v2 h-6 z
                          M6,18 h4 v2 h-4 z
                          M6,20 h2 v2 h-2 z" />
</vector>
