        android:fillColor="#FFFFFFFF"
        android:pathData="M10,0 h4 v2 h-4 z
                          M8,2 h8 v4 h-8 z
                          M6,6 h4 v4 h-4 z
                          M14,6 h4 v4 h-4 z
                          M4,10 h16 v2 h-16 z
                          M4,12 h4 v2 h-4 z
                          M16,12 h4 v2 h-4 z
                          M2,14 h4 v4 h-4 z
                          M18,14 h4 v4 h-4 z
                          M0,18 h4 v4 h-4 z
                          M20,18 h4 v4 h-4 z" />
</vector>
