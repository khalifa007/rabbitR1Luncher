<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixel-art sparkle: 4-point star with full-length vertical + horizontal
  arms and a stepped diamond center. Reads as AI / generation cue.
  12x12 logical grid, each pixel = 2x2 viewport units.

  Used by HermesActivityIcon (topbar, 14dp pulsing) and HermesThinkingBubble
  (chat bubble, 18dp pulsing).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10,0 h4 v6 h-4 z
                          M8,6 h8 v2 h-8 z
                          M6,8 h12 v2 h-12 z
                          M0,10 h24 v4 h-24 z
                          M6,14 h12 v2 h-12 z
                          M8,16 h8 v2 h-8 z
                          M10,18 h4 v6 h-4 z" />
</vector>
