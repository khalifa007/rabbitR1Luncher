<?xml version="1.0" encoding="utf-8"?>
<!--
  Lucide-style bluetooth rune: stroked outline (NOT filled), matches the
  rest of the topbar's stroke-based icon family. Single continuous path
  forms the classic Bluetooth Z-rune: from upper-left corner diagonal
  through center down to bottom-right, up to the bottom tip, up the
  central spine to the top tip, back down through center to lower-left.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7 7 L17 17 L12 22 L12 2 L17 7 L7 17" />
</vector>
