<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixel-art phone icon: tall rectangle frame with bezels top + bottom.
  12x12 logical grid, each pixel = 2x2 viewport units.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,0 h14 v4 h-14 z
                          M4,20 h14 v4 h-14 z
                          M4,4 h2 v16 h-2 z
                          M16,4 h2 v16 h-2 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10,20 h2 v2 h-2 z" />
</vector>
