<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixel-art info "i" glyph: dot + serif stem.
  12x12 logical grid, each pixel = 2x2 viewport units.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10,2 h4 v4 h-4 z
                          M8,8 h8 v2 h-8 z
                          M10,10 h4 v10 h-4 z
                          M8,20 h8 v2 h-8 z" />
</vector>
