<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixel-art signal bars: 4 vertical 2x2-foot pixel bars stair-stepping in
  height. Viewport 14x10 matches the topbar Image size for crisp 1:1 render.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="14dp"
    android:height="10dp"
    android:viewportWidth="14"
    android:viewportHeight="10">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M1,6 h2 v2 h-2 z
                          M4,4 h2 v4 h-2 z
                          M7,2 h2 v6 h-2 z
                          M10,0 h2 v8 h-2 z" />
</vector>
