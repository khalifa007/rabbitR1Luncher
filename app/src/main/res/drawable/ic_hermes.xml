<?xml version="1.0" encoding="utf-8"?>
<!--
    Hermes Agent app icon — winged glyph evoking Hermes' caduceus / messenger
    motif, drawn as a vertical staff with two outstretched wings, same solid-fill
    style as ic_claude.xml / ic_terminal.xml. Renders cleanly at 24dp on the
    apps grid; AppCard tints don't apply (white path stays white over the tile
    background color from APP_PALETTE).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- vertical staff -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11,3 L13,3 L13,21 L11,21 Z" />
    <!-- top crescent / messenger orb -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z M12,2 m-1.5,0 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0 Z" />
    <!-- left wing -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11,8 L3,7 L4,9 L11,10 Z" />
    <!-- right wing -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13,8 L21,7 L20,9 L13,10 Z" />
</vector>
