<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixel-art shopping bag with handles. tint="@color/fg" preserved.
  12x12 logical grid, each pixel = 2x2 viewport units.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/fg">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6,0 h4 v2 h-4 z
                          M14,0 h4 v2 h-4 z
                          M4,2 h6 v2 h-6 z
                          M14,2 h6 v2 h-6 z
                          M4,4 h2 v4 h-2 z
                          M18,4 h2 v4 h-2 z
                          M2,8 h20 v14 h-20 z" />
</vector>
